<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the look is handled by GriotTheme (Compose). -->
    <style name="Theme.Griot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/griot_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash, handed off to the Compose launch screen that shows the same tile at the same place. -->
    <style name="Theme.Griot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/griot_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Griot</item>
    </style>
</resources>
